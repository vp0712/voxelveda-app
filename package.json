{
  "name": "voxelveda-backend",
  "version": "1.0.0",
  "description": "Voxel Veda original operational application and security backend",
  "main": "server.js",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "check": "node scripts/check-syntax.js",
    "lint": "node scripts/check-syntax.js",
    "typecheck": "node scripts/check-syntax.js",
    "test": "node scripts/application-regression-suite.js",
    "build": "npm run check && npm test",
    "audit:inventory": "node scripts/generate-enterprise-inventory.js",
    "audit:inventory:check": "node scripts/check-enterprise-audit-provenance.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/secret-scan.js",
    "readiness:check": "node scripts/check-production-readiness.js",
    "test:mysql": "node scripts/retained-mysql-test.js",
    "test:registration": "node scripts/customer-registration-test.js",
    "test:retirement": "node scripts/application-retirement-test.js",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "test:workflows": "node scripts/original-workflow-test.js && node scripts/core-workflow-test.js",
    "test:pdf": "node scripts/document-pdf-delivery-test.js && node scripts/document-delivery-lifecycle-test.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@napi-rs/canvas": "^1.0.9",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
