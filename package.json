{
  "name": "voxelveda-backend",
  "version": "1.0.0",
  "description": "Voxel Veda customer workspace and secure enquiry backend",
  "main": "server.js",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "check": "node scripts/check-syntax.js",
    "lint": "node scripts/check-syntax.js",
    "typecheck": "node scripts/check-syntax.js",
    "test": "node scripts/application-regression-suite.js",
    "build": "npm run check && npm test",
    "audit:inventory": "node scripts/generate-enterprise-inventory.js",
    "audit:inventory:check": "node scripts/check-enterprise-audit-provenance.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/secret-scan.js",
    "readiness:check": "node scripts/check-production-readiness.js",
    "test:mysql": "node scripts/retained-mysql-test.js",
    "test:registration": "node scripts/customer-registration-test.js",
    "test:rfq": "node scripts/customer-rfq-intake-test.js",
    "test:retirement": "node scripts/application-retirement-test.js",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.0.12",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
