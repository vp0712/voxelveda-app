PORT=5001
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed to call the API.
# Example: https://voxelveda-app-production.up.railway.app,https://www.voxelveda.com
CORS_ORIGINS=https://voxelveda-app-production.up.railway.app

# Request limits and rate limits
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=900
AUTH_RATE_LIMIT_MAX=25

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
