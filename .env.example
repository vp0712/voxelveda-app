PORT=5001
NODE_ENV=production
APP_NAME=Voxel Veda Operations
JWT_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex
MFA_REQUIRED_ROLES=super_admin,admin,finance_admin,accountant,hr
SESSION_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=8h
PRIVILEGED_SESSION_EXPIRES_IN=2h
STEP_UP_TTL_MINUTES=15
FINANCE_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex
SHIFT_QR_SIGNING_KEY=replace-with-a-different-32-byte-base64-or-64-character-hex
HIGH_RISK_PAYMENT_THRESHOLD=5000.00
BANK_DETAIL_RECENT_DAYS=7
PAYMENT_APPROVAL_TTL_HOURS=24
PASSWORD_MIN_LENGTH=14
ALLOW_PUBLIC_CUSTOMER_REGISTRATION=false
ALLOW_LEGACY_QUERY_TOKENS=false
ENABLE_ADMIN_BOOTSTRAP=false
APP_URL=https://app.voxelveda.com
PUBLIC_WEBSITE_URL=https://voxelveda.com
PUBLIC_APP_URL=https://app.voxelveda.com
API_BASE_URL=https://app.voxelveda.com/api
APP_ORIGIN=https://app.voxelveda.com
COOKIE_DOMAIN=.voxelveda.com
TRUST_PROXY=true
FORCE_CANONICAL_HOST=false
RAILWAY_FALLBACK_HOST=voxelveda-app-production.up.railway.app

# Comma-separated origins allowed to call the API.
# Include only trusted browser origins. Keep the temporary Railway origin during migration.
ALLOWED_ORIGINS=https://app.voxelveda.com,https://voxelveda.com,https://voxelveda-app-production.up.railway.app

# Request limits and rate limits
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=900
RATE_LIMIT_STORE=memory
RATE_LIMIT_NAMESPACE=voxelveda:rate-limit
RATE_LIMIT_FAILURE_POLICY=deny
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
LOGIN_RATE_LIMIT_MAX=10
MFA_RATE_LIMIT_MAX=12
STEP_UP_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=6
INVITATION_RATE_LIMIT_MAX=10
CUSTOMER_REGISTRATION_RATE_LIMIT_MAX=5
PUBLIC_RFQ_RATE_LIMIT_MAX=10
AI_LEAD_RATE_LIMIT_MAX=10
SHIFT_QR_RATE_LIMIT_MAX=120
QR_GENERATION_RATE_LIMIT_MAX=60
COC_VERIFY_RATE_LIMIT_MAX=120
CSP_REPORT_RATE_LIMIT_MAX=30
BOT_CHALLENGE_PROVIDER=none
BOT_CHALLENGE_REQUIRED_ENDPOINTS=
# MySQL-backed leases make singleton workers safe across replicas.
BACKGROUND_JOB_LEASE_MS=120000
BACKGROUND_JOB_MAX_ATTEMPTS=5
BACKGROUND_JOB_RETRY_BASE_MS=30000
BACKGROUND_JOB_RETRY_MAX_MS=3600000
TRASH_PURGE_INTERVAL_MS=3600000
TRASH_PURGE_BATCH_SIZE=50
TRASH_PURGE_LEASE_MS=900000
WORKFLOW_SLA_INTERVAL_MS=300000
WORKFLOW_SLA_LEASE_MS=300000

# Operational attestations. Do not set these to configured unless backed by real services.
MALWARE_SCANNER_PROVIDER=
BACKUP_STATUS_PROVIDER=unverified
WEBHOOK_SIGNING_KEY=
WEBHOOK_SIGNING_KEY_VERSION=v1
OUTBOUND_ALLOWED_HOSTS=
DUAL_CONTROL_EXPORTS=false

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=
DB_TLS_REQUIRED=false
DB_TLS_REJECT_UNAUTHORIZED=true
DB_TLS_CA_BASE64=
DB_TLS_CA_FILE=
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
MIGRATION_LOCK_TIMEOUT_SECONDS=60

# Governance thresholds flag accounts for human review; they never auto-disable a user.
STALE_ACCOUNT_REVIEW_DAYS=60
STALE_ACCOUNT_HIGH_RISK_DAYS=90

# Email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=info@voxelveda.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Voxel Veda
MAIL_FROM_ADDRESS=info@voxelveda.com
MAIL_REPLY_TO=info@voxelveda.com
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
EMAIL_QUEUE_INTERVAL_MS=30000
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_WORKER_MAX_ATTEMPTS=8
WEEKLY_TIMESHEET_EMAIL_ENABLED=true
WEEKLY_TIMESHEET_EMAIL_TIMEZONE=Australia/Sydney
WEEKLY_TIMESHEET_EMAIL_HOUR=7
WEEKLY_TIMESHEET_EMAIL_INTERVAL_MS=900000
WEEKLY_TIMESHEET_LEASE_MS=900000
TIMESHEET_APPROVAL_EMAIL_ENABLED=false
TIMESHEET_REVIEW_EMAIL_ENABLED=false
SUPPORT_EMAIL=info@voxelveda.com
# Optional assurance integrations. Empty values keep the related capability restricted.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
SECURITY_EVENT_DESTINATION=
