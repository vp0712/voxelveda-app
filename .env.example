PORT=5001
NODE_ENV=production
APP_NAME=Voxel Veda Operations
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=30d
APP_URL=https://app.voxelveda.com
PUBLIC_WEBSITE_URL=https://voxelveda.com
PUBLIC_APP_URL=https://app.voxelveda.com
API_BASE_URL=https://app.voxelveda.com/api
APP_ORIGIN=https://app.voxelveda.com
COOKIE_DOMAIN=.voxelveda.com
TRUST_PROXY=true
FORCE_CANONICAL_HOST=false
RAILWAY_FALLBACK_HOST=your-current-railway-service-hostname

# Comma-separated origins allowed to call the API.
# Include only trusted browser origins. Keep the temporary Railway origin during migration.
ALLOWED_ORIGINS=https://app.voxelveda.com,https://voxelveda.com

# Request limits and rate limits
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=900
AUTH_RATE_LIMIT_MAX=25

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
EMAIL_FROM=
SUPPORT_EMAIL=
