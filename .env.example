PORT=5001
NODE_ENV=production
APP_NAME=Voxel Veda Operations
JWT_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex
MFA_REQUIRED_ROLES=super_admin,admin,finance_admin,accountant,hr
SESSION_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=8h
PRIVILEGED_SESSION_EXPIRES_IN=2h
STEP_UP_TTL_MINUTES=15
FINANCE_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex
HIGH_RISK_PAYMENT_THRESHOLD=5000.00
BANK_DETAIL_RECENT_DAYS=7
PASSWORD_MIN_LENGTH=14
ALLOW_PUBLIC_CUSTOMER_REGISTRATION=false
ALLOW_LEGACY_QUERY_TOKENS=false
ENABLE_ADMIN_BOOTSTRAP=false
APP_URL=https://app.voxelveda.com
PUBLIC_WEBSITE_URL=https://voxelveda.com
PUBLIC_APP_URL=https://app.voxelveda.com
API_BASE_URL=https://app.voxelveda.com/api
APP_ORIGIN=https://app.voxelveda.com
COOKIE_DOMAIN=.voxelveda.com
TRUST_PROXY=true
FORCE_CANONICAL_HOST=false
RAILWAY_FALLBACK_HOST=voxelveda-app-production.up.railway.app

# Comma-separated origins allowed to call the API.
# Include only trusted browser origins. Keep the temporary Railway origin during migration.
ALLOWED_ORIGINS=https://app.voxelveda.com,https://voxelveda.com,https://voxelveda-app-production.up.railway.app

# Request limits and rate limits
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=900
AUTH_RATE_LIMIT_MAX=25

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# Email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=info@voxelveda.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Voxel Veda
MAIL_FROM_ADDRESS=info@voxelveda.com
MAIL_REPLY_TO=info@voxelveda.com
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
EMAIL_QUEUE_INTERVAL_MS=30000
EMAIL_QUEUE_BATCH_SIZE=10
WEEKLY_TIMESHEET_EMAIL_ENABLED=true
WEEKLY_TIMESHEET_EMAIL_TIMEZONE=Australia/Sydney
WEEKLY_TIMESHEET_EMAIL_HOUR=7
WEEKLY_TIMESHEET_EMAIL_INTERVAL_MS=900000
TIMESHEET_APPROVAL_EMAIL_ENABLED=false
TIMESHEET_REVIEW_EMAIL_ENABLED=false
SUPPORT_EMAIL=info@voxelveda.com
